# Studio vidéo — fichiers à ne jamais publier.
# Règle générale : on versionne les sources (code, scènes, capsule.json, docs) ;
# tout ce qui se régénère (builds, caches, voix, musique, rendus) ou qui est
# personnel (clés, projets des utilisateurs) reste hors du dépôt.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Les clés (OPENROUTER_API_KEY, BRAVE_API_KEY, TAVILY_API_KEY) se lisent dans
# l'environnement uniquement ; ces motifs rattrapent un fichier écrit par erreur.
.env
.env.*
!.env.example
*.env
.envrc
*.key
*.pem
*.p12
*.pfx
secrets/
*secret*.json
*credentials*.json
.npmrc.local
.netrc

# ── Node / TypeScript ────────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
.eslintcache
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.vitest/

# ── Python (packages/audio, .venv) ───────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── Playwright / Chromium ────────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/
.cache/

# ── Projets vidéo ────────────────────────────────────────────────────────────
# Seul le projet de référence est publié. Les autres projets de projects/ sont
# personnels : ils restent sur la machine, hors du dépôt.
projects/*
!projects/tsconfig.json
!projects/panoptique/

# Dans tout projet (y compris panoptique) : cache, rendus et voix générées.
.studio/
out/
# Voix off : clips TTS payés à la génération, propres à chaque utilisateur.
# `studio make` les régénère (avec clé) ou estime les durées (sans clé).
voice/
# Sources lourdes de médias et scripts de travail personnels
media-src/

# ── Médias générés, où qu'ils soient ─────────────────────────────────────────
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.pcm
*.mp3
*.flac
*.ogg
*.m4a
*.aac
contact_sheet*.png
*.log

# ── Système et éditeurs ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.#*
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace
.fleet/
.zed/

# ── Agents ───────────────────────────────────────────────────────────────────
# Réglages locaux de Claude Code (AGENTS.md et CLAUDE.md, eux, sont publiés).
.claude/settings.local.json
.claude-transfer/
CLAUDE.local.md

# ── Divers ───────────────────────────────────────────────────────────────────
*.tgz
*.tar.gz
*.zip
tmp/
.tmp/
