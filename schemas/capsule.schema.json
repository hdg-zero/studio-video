{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kicker": {
      "default": "",
      "type": "string"
    },
    "credits": {
      "default": "",
      "type": "string"
    },
    "closingLine": {
      "default": "",
      "type": "string"
    },
    "language": {
      "default": "fr",
      "type": "string"
    },
    "format": {
      "default": {},
      "type": "object",
      "properties": {
        "width": {
          "default": 1920,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "default": 1080,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "pixelRatio": {
          "default": 1.5,
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "look": {
      "default": {},
      "type": "object",
      "properties": {
        "background": {
          "default": "#01030a",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "default": "#ffb35c",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fogDensity": {
          "default": 0.015,
          "type": "number",
          "minimum": 0
        },
        "bloom": {
          "default": 0.9,
          "type": "number",
          "minimum": 0
        },
        "exposure": {
          "default": 1.1,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "msaa": {
          "default": 4,
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "voice": {
      "default": {},
      "type": "object",
      "properties": {
        "model": {
          "default": "fish-audio/s2.1-pro-free:free",
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "concurrency": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "credit": {
          "default": "",
          "type": "string"
        }
      }
    },
    "timing": {
      "default": {},
      "type": "object",
      "properties": {
        "introLead": {
          "default": 3.2,
          "type": "number",
          "minimum": 0
        },
        "lead": {
          "default": 0.9,
          "type": "number",
          "minimum": 0
        },
        "tail": {
          "default": 1.1,
          "type": "number",
          "minimum": 0
        },
        "outroTail": {
          "default": 1.8,
          "type": "number",
          "minimum": 0
        },
        "credits": {
          "default": 6,
          "type": "number",
          "minimum": 0
        },
        "readingSpeed": {
          "default": 15,
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "music": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "root": {
          "default": 50,
          "type": "integer",
          "minimum": 24,
          "maximum": 84
        },
        "major": {
          "default": false,
          "type": "boolean"
        },
        "gain": {
          "default": 0.55,
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "duck": {
          "default": 0.55,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "default": 7,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "subtitles": {
      "default": {},
      "type": "object",
      "properties": {
        "style": {
          "default": "auto",
          "type": "string",
          "enum": ["auto", "line", "words"]
        }
      }
    },
    "segments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "mood": {
            "default": "calm",
            "type": "string",
            "enum": ["intro", "calm", "pulse", "build", "explosion", "suspense", "bright", "dark", "minimal", "finale"]
          },
          "label": {
            "default": "",
            "type": "string"
          },
          "key": {
            "default": "",
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "src": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!\\.)(?!.*\\.\\.)[^\\\\:]+$"
                  },
                  "motion": {
                    "default": "zoom-in",
                    "type": "string",
                    "enum": ["zoom-in", "zoom-out", "pan-left", "pan-right", "pan-up", "pan-down", "still"]
                  },
                  "focus": {
                    "default": [0.5, 0.5],
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "fit": {
                    "default": "cover",
                    "type": "string",
                    "enum": ["cover", "contain"]
                  },
                  "dim": {
                    "default": 0.35,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "caption": {
                    "default": "",
                    "type": "string"
                  },
                  "credit": {
                    "default": "",
                    "type": "string"
                  }
                },
                "required": ["type", "src"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "video"
                  },
                  "src": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!\\.)(?!.*\\.\\.)[^\\\\:]+$"
                  },
                  "start": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0
                  },
                  "loop": {
                    "default": true,
                    "type": "boolean"
                  },
                  "fit": {
                    "default": "cover",
                    "type": "string",
                    "enum": ["cover", "contain"]
                  },
                  "dim": {
                    "default": 0.35,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "caption": {
                    "default": "",
                    "type": "string"
                  },
                  "credit": {
                    "default": "",
                    "type": "string"
                  }
                },
                "required": ["type", "src"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "title"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sub": {
                    "default": "",
                    "type": "string"
                  }
                },
                "required": ["type", "text"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "quote"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "author": {
                    "default": "",
                    "type": "string"
                  }
                },
                "required": ["type", "text"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "stat"
                  },
                  "value": {
                    "type": "number"
                  },
                  "decimals": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "prefix": {
                    "default": "",
                    "type": "string"
                  },
                  "suffix": {
                    "default": "",
                    "type": "string"
                  },
                  "label": {
                    "default": "",
                    "type": "string"
                  }
                },
                "required": ["type", "value"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "list"
                  },
                  "items": {
                    "minItems": 1,
                    "maxItems": 7,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "numbered": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": ["type", "items"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "chart"
                  },
                  "kind": {
                    "default": "bar",
                    "type": "string",
                    "enum": ["bar", "line"]
                  },
                  "data": {
                    "minItems": 1,
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "default": "",
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      },
                      "required": ["value"]
                    }
                  },
                  "unit": {
                    "default": "",
                    "type": "string"
                  },
                  "title": {
                    "default": "",
                    "type": "string"
                  }
                },
                "required": ["type", "data"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "dates"
                  },
                  "events": {
                    "minItems": 1,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "date": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "default": "",
                          "type": "string"
                        }
                      },
                      "required": ["date"]
                    }
                  }
                },
                "required": ["type", "events"]
              }
            ]
          }
        },
        "required": ["id", "text"]
      }
    }
  },
  "required": ["title", "segments"]
}
